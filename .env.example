# ─────────────────────────────────────────────────────────────
# Environment Variables — copy to .env and fill in your values
# NEVER commit the real .env file to version control
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME="AI Customer Support API"
APP_VERSION="1.0.0"
APP_ENV="development"       # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# ── Server ────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Primary names (used by Render and this project)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="ai_support"

# Legacy aliases (kept for backwards compatibility — override the above if set)
# MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"
# MONGODB_DB_NAME="ai_support"

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── Security / JWT ───────────────────────────────────────────
SECRET_KEY="change-me-to-a-long-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google Gemini ────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40
GEMINI_HISTORY_LIMIT=10
GEMINI_TIMEOUT=30

# ── Knowledge Base / ChromaDB ───────────────────────────────
CHROMA_PERSIST_DIR="./chroma_data"
CHROMA_COLLECTION_NAME="knowledge_base_vectors"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
KB_MAX_FILE_SIZE_MB=20
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
KB_MIN_CHUNK_SIZE=100
KB_ALLOWED_EXTENSIONS="pdf,docx,txt,csv,json,md"
KB_UPLOAD_DIR="./uploads/knowledge"

# ── RAG ─────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.55
RAG_MIN_CHUNKS_FOR_ANSWER=1
RAG_MAX_CONTEXT_CHARS=6000
RAG_ESCALATION_MESSAGE="I'm not confident enough to answer this question accurately. Your request has been forwarded to a human support agent who will assist you shortly."

# ── Intent / Sentiment / Escalation ─────────────────────────
INTENT_MODEL="gemini-1.5-flash"
INTENT_TEMPERATURE=0.0
INTENT_TIMEOUT=15
INTENT_CONFIDENCE_THRESHOLD=0.6
SENTIMENT_MODEL="gemini-1.5-flash"
SENTIMENT_TEMPERATURE=0.0
SENTIMENT_TIMEOUT=12
SENTIMENT_CONFIDENCE_THRESHOLD=0.55
ESCALATION_SENTIMENT_POLARITY=-1.0
ESCALATION_NEGATIVE_STREAK=2
ESCALATION_UNANSWERED_THRESHOLD=3
ESCALATION_HUMAN_KEYWORDS="human,agent,real person,speak to someone,manager,supervisor,escalate,cancel account,legal,lawyer,lawsuit,refund now"

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL="INFO"            # DEBUG | INFO | WARNING | ERROR | CRITICAL
